var D = {"\u70b9\u51fb\u590d\u5236\u5fae\u4fe1\u53f7": ["Tap to copy WeChat ID", "\uc704\ucc57 \uc544\uc774\ub514 \ubcf5\uc0ac"], "\u70b9\u51fb\u67e5\u770b\u5c0f\u732b\u8db3\u8ff9": ["View kitten footprints", "\uc544\uae30 \uace0\uc591\uc774 \ubc1c\uc790\uad6d \ubcf4\uae30"], "\u7b5b\u9009\u5c0f\u732b": ["Filter kittens", "\uc544\uae30 \uace0\uc591\uc774 \ud544\ud130"], "\u65b0\u732b\u5230\u5bb6\u6307\u5357": ["New Kitten Go-Home Guide", "\uc0c8 \uc544\uae30 \uace0\uc591\uc774 \ub9de\uc774 \uac00\uc774\ub4dc"], "\u539f\u6728\u722c\u67b6\uff0c\u85e4\u7bee\u79cb\u5343\uff0c\u5c3d\u60c5\u5b09\u620f": ["Log climbing frames, rattan swings \u2014 endless play", "\uc6d0\ubaa9 \ucea3\ud0c0\uc6cc\uc640 \ub77c\ud0c4 \ubc14\uad6c\ub2c8\uc5d0\uc11c \ub9c8\uc74c\uaecf \ub180\uc544\uc694"], "\u9752\u77f3\u5c0f\u5f84\uff0c\u7eff\u610f\u5939\u9053\uff0c\u60a0\u7136\u6f2b\u6b65": ["A stone path lined with greenery for leisurely strolls", "\ucd08\ub85d\uc774 \uc6b0\uac70\uc9c4 \ub3cc\uae38\uc744 \uc5ec\uc720\ub86d\uac8c \uc0b0\ucc45\ud574\uc694"], "\u6253\u75ab\u82d7": ["Vaccinated", "\uc608\ubc29\uc811\uc885"], "\u8840\u6e05\u68c0\u6d4b": ["Rabies Serology", "\ud56d\uccb4\uac00 \uac80\uc0ac"], "\u9884\u8ba1\u51fa\u53d1": ["Departure Planned", "\ucd9c\ubc1c \uc608\uc815"], "\u5c0f\u732b\u65e5\u8bb0": ["Kitten Diary", "\uc544\uae30 \uace0\uc591\uc774 \uc77c\uae30"], "\u51fa\u751f\u4e86": ["Born", "\ud0dc\uc5b4\ub0ac\uc5b4\uc694"], "\u5b9a\u4e0b\u65b0\u5bb6": ["A Family Found", "\uc0c8 \uac00\uc871 \ud655\uc815"], "\u51fa\u53d1": ["Off to the New Home", "\uc0c8 \uc9d1\uc73c\ub85c \ucd9c\ubc1c"], "\u65b0\u5bb6": ["New home", "\uc0c8 \uc9d1"], "\u751f\u65e5": ["Born", "\uc0dd\uc77c"], "\u51fa\u53d1\u53bb\u65b0\u5bb6\u5566": ["Packed up and off to the new home!", "\uc0c8 \uc9d1\uc73c\ub85c \ucd9c\ubc1c\ud588\uc5b4\uc694!"], "\u4e0e\u65b0\u5bb6\u5ead\u7ed3\u7f18\u5566": ["Matched with a loving family", "\uc0c8 \uac00\uc871\uacfc \uc778\uc5f0\uc744 \ub9fa\uc5c8\uc5b4\uc694"], "\u671f\u5f85\u5bb6\u957f\u7684\u6765\u4fe1": ["Awaiting news from the family", "\uac00\uc871\uc758 \uc18c\uc2dd\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694"], "\u7e41\u80b2\u7406\u5ff5": ["Philosophy", "\ube0c\ub9ac\ub529 \ucca0\ud559"], "\u751f\u9aa8\u8089\u5582\u517b": ["Raw Diet", "\uc0dd\uc2dd \uae09\uc5ec"], "\u732b\u820d": ["Cattery", "\uce90\ud130\ub9ac"], "\u6211\u4eec\u4e3a\u7f05\u56e0\u732b\u6253\u9020\u4e86\u5b89\u5168\u3001\u8212\u9002\u3001\u81ea\u7136\u7684\u751f\u6d3b\u73af\u5883\uff0c\u8ba9\u6bcf\u4e00\u53ea\u732b\u54aa\u90fd\u80fd\u5065\u5eb7\u6210\u957f\uff0c\u5feb\u4e50\u751f\u6d3b\u3002": ["We have built a safe, comfortable and natural home for our Maine Coons, where every cat grows up healthy and happy.", "\uba54\uc778\ucfe4\uc744 \uc704\ud574 \uc548\uc804\ud558\uace0 \ud3b8\uc548\ud558\uba70 \uc790\uc5f0 \uce5c\ud654\uc801\uc778 \ud658\uacbd\uc744 \ub9cc\ub4e4\uc5b4, \ubaa8\ub4e0 \uace0\uc591\uc774\uac00 \uac74\uac15\ud558\uace0 \ud589\ubcf5\ud558\uac8c \uc790\ub77c\ub3c4\ub85d \ud569\ub2c8\ub2e4."], "\u6237\u5916\u6d3b\u52a8\u533a": ["Outdoor Play Area", "\uc57c\uc678 \ud65c\ub3d9 \uad6c\uc5ed"], "\u7eff\u690d\u73af\u7ed5\uff0c\u5bbd\u655e\u5b89\u5168\uff0c\u81ea\u7531\u63a2\u7d22": ["Surrounded by greenery \u2014 spacious, safe, free to explore", "\ub179\uc9c0\ub85c \ub458\ub7ec\uc2f8\uc778 \ub113\uace0 \uc548\uc804\ud55c \uc790\uc720 \ud0d0\ud5d8 \uacf5\uac04"], "\u8212\u9002\u751f\u6d3b\u533a": ["Comfortable Living Area", "\ucf8c\uc801\ud55c \uc0dd\ud65c \uad6c\uc5ed"], "\u5e72\u51c0\u6574\u6d01\uff0c\u6e29\u99a8\u8212\u9002\uff0c\u542b\u6bcd\u5a74\u5b89\u9759\u533a\u57df": ["Clean and cozy, with a quiet space for mothers and kittens", "\uccad\uacb0\ud558\uace0 \uc544\ub291\ud558\uba70, \uc5b4\ubbf8\uc640 \uc544\uae30\ub97c \uc704\ud55c \uc870\uc6a9\ud55c \uacf5\uac04 \ud3ec\ud568"], "\u5ba4\u5185\u6d3b\u52a8\u533a": ["Indoor Play Area", "\uc2e4\ub0b4 \ud65c\ub3d9 \uad6c\uc5ed"], "\u8bbe\u65bd\u4e30\u5bcc\uff0c\u5b89\u5fc3\u4f11\u61a9\uff0c\u966a\u4f34\u6210\u957f": ["Rich facilities and restful nooks for growing up in company", "\ud48d\ubd80\ud55c \uc2dc\uc124\uacfc \ud3b8\uc548\ud55c \ud734\uc2dd, \ud568\uaed8\ud558\ub294 \uc131\uc7a5"], "\u5b89\u5168\u9632\u62a4": ["Safety First", "\uc548\uc804 \ubcf4\ud638"], "\u5168\u65b9\u4f4d\u9632\u62a4\u63aa\u65bd": ["All-round protective measures", "\uc804\ubc29\uc704 \ubcf4\ud638 \uc870\uce58"], "\u81ea\u7136\u5065\u5eb7": ["Natural & Healthy", "\uc790\uc5f0 \uce5c\ud654"], "\u7eff\u690d\u73af\u7ed5\uff0c\u7a7a\u6c14\u6e05\u65b0": ["Greenery all around, fresh air", "\ub179\uc9c0\ub85c \ub458\ub7ec\uc2f8\uc778 \ub9d1\uc740 \uacf5\uae30"], "\u5b9a\u671f\u6e05\u6d01": ["Regular Cleaning", "\uc815\uae30 \uccad\uc18c"], "\u6bcf\u65e5\u6e05\u626b\uff0c\u5b9a\u671f\u6d88\u6bd2": ["Daily cleaning, regular disinfection", "\ub9e4\uc77c \uccad\uc18c, \uc815\uae30 \uc18c\ub3c5"], "\u7528\u5fc3\u7167\u62a4": ["Attentive Care", "\uc815\uc131 \uc5b4\ub9b0 \ubcf4\uc0b4\ud54c"], "\u79d1\u5b66\u5582\u517b\uff0c\u8d34\u5fc3\u966a\u4f34": ["Scientific feeding, devoted companionship", "\uacfc\ud559\uc801\uc778 \uae09\uc5ec\uc640 \uc138\uc2ec\ud55c \ub3cc\ubd04"], "\u672c\u732b\u820d\u63d0\u5021\u751f\u9aa8\u8089\u5582\u517b\uff1a\u9009\u7528\u65b0\u897f\u5170\u8fdb\u53e3\u94f6\u8568\u3001\u5f3a\u82f1\u3001\u534e\u82f1\u7b49\u54c1\u724c\u8089\u6e90\uff0c\u4e14\u5fc5\u987b\u7ecf\u8fc7\u4e25\u683c\u8d85\u4f4e\u6e29\u51b7\u51bb\uff08\u5982 SIEE \u751f\u9aa8\u8089\uff09\u3002\u5c0f\u732b\u4ece 45 \u5929\u65ad\u5976\u8d77\u5c31\u5403\u751f\u9aa8\u8089\uff0c\u808c\u8089\u66f4\u7ed3\u5b9e\u3001\u8eab\u4f53\u66f4\u5065\u5eb7\uff1b\u5076\u5c14\u52a0\u9910\u51bb\u5e72\u4e0e\u7f50\u5934\uff0c\u5e76\u4e0d\u5b9a\u671f\u8865\u5145\u8425\u517b\u54c1\u548c\u4fdd\u5065\u54c1\u3002": ["We feed a raw diet: meat sourced from trusted brands such as New Zealand's Silver Fern, always deep-frozen at ultra-low temperatures (e.g. SIEE raw food). Kittens start raw from weaning at 45 days \u2014 firmer muscles and better health \u2014 with freeze-dried treats, canned food and periodic supplements on the side.", "\uc800\ud76c\ub294 \uc0dd\uace8\uc721 \uae09\uc5ec\ub97c \uc9c0\ud5a5\ud569\ub2c8\ub2e4. \ub274\uc9c8\ub79c\ub4dc\uc0b0 \uc2e4\ubc84\ud380 \ub4f1 \uac80\uc99d\ub41c \ube0c\ub79c\ub4dc\uc758 \uc721\ub958\ub97c \uc0ac\uc6a9\ud558\uba70, \ucd08\uc800\uc628 \ub0c9\ub3d9\uc744 \uac70\uce5c \uc0dd\uc2dd(\uc608: SIEE)\ub9cc \uae09\uc5ec\ud569\ub2c8\ub2e4. \uc544\uae30 \uace0\uc591\uc774\ub294 \uc0dd\ud6c4 45\uc77c \uc774\uc720 \ud6c4\ubd80\ud130 \uc0dd\uc2dd\uc744 \uc2dc\uc791\ud574 \uadfc\uc721\uc774 \ud0c4\ud0c4\ud558\uace0 \ub354 \uac74\uac15\ud558\uac8c \uc790\ub77c\uba70, \uac04\uc2dd\uc73c\ub85c \ub3d9\uacb0\uac74\uc870\u00b7\uce94\uc744 \uc8fc\uace0 \uc601\uc591\uc81c\ub3c4 \uc218\uc2dc\ub85c \ubcf4\ucda9\ud569\ub2c8\ub2e4."], "\u8425\u517b\u54c1 / \u4fdd\u5065\u54c1": ["Supplements & Health Care", "\uc601\uc591\uc81c / \ubcf4\uc870\uc81c"], "\u5e03\u62c9\u8fea\u76ca\u751f\u83cc\u3001\u6dfb\u8d50\u529b\u514d\u75ab\u589e\u5f3a\u818f\u3001MAG \u5375\u78f7\u8102\u3001MAG 95% Omega-3 \u9c7c\u6cb9\u3001VIYO \u8425\u517b\u6db2\u3001\u9ad8\u514d\u56e0\u5b50\u3001\u7f8e\u5c3c\u55b5\u8d56\u6c28\u9178\u3001\u5feb\u4e50\u7ea2\u7cd6\u7b49\u3002": ["Saccharomyces boulardii probiotics, immune-boost paste, MAG lecithin, MAG 95% omega-3 fish oil, VIYO drink, immune factors, lysine and more.", "\ubd80\ub77c\ub514 \uc720\uc0b0\uade0, \uba74\uc5ed \uac15\ud654 \ud398\uc774\uc2a4\ud2b8, MAG \ub808\uc2dc\ud2f4, MAG 95% \uc624\uba54\uac003 \ud53c\uc2dc\uc624\uc77c, VIYO \uc601\uc591\uc561, \uba74\uc5ed \uc778\uc790, \ub77c\uc774\uc2e0 \ub4f1."], "\u5b9a\u5236\u732b\u7802": ["Custom Cat Litter", "\ub9de\ucda4 \uace0\uc591\uc774 \ubaa8\ub798"], "\u4e13\u95e8\u5b9a\u5236\u9ad8\u54c1\u8d28\u3001\u65e0\u9999\u578b\u6df7\u5408\u732b\u7802\uff0c\u5bf9\u732b\u54aa\u547c\u5438\u9053\u66f4\u53cb\u597d\u3002": ["Specially made premium unscented mixed litter \u2014 gentler on cats' airways.", "\uace0\ud488\uc9c8 \ubb34\ud5a5 \ud63c\ud569 \ubaa8\ub798\ub97c \ub9de\ucda4 \uc81c\uc791\ud574 \ud638\ud761\uae30\uc5d0 \ub354 \uc21c\ud569\ub2c8\ub2e4."], "\u9996\u9875": ["Home", "\ud648"], "\u5728\u552e\u5e7c\u732b": ["Kittens", "\ubd84\uc591\ubb18"], "\u79cd\u732b\u5c55\u793a": ["Our Cats", "\ubd80\ubaa8\ubb18"], "\u5173\u4e8e\u6211\u4eec": ["About", "\uc18c\uac1c"], "\u732b\u820d\u73af\u5883": ["Cattery", "\uce90\ud130\ub9ac"], "\u8054\u7cfb\u6211\u4eec": ["Contact", "\uc5f0\ub77d\ucc98"], "\u4e13\u6ce8\u7f05\u56e0\u732b\uff0c\u4f20\u627f\u4f18\u79c0\u8840\u7edf\u3002": ["Devoted to Maine Coons, preserving excellent bloodlines.", "\uba54\uc778\ucfe4\uc5d0 \uc804\ub150\ud558\uba70, \uc6b0\uc218\ud55c \ud608\ud1b5\uc744 \uc774\uc5b4\uac11\ub2c8\ub2e4."], "\u4ee5\u5065\u5eb7\u3001\u4f53\u578b\u4e0e\u6e29\u67d4\u6027\u683c\u4e3a\u6838\u5fc3\uff0c\u8d1f\u8d23\u4efb\u5730\u7e41\u80b2\u9ad8\u54c1\u8d28\u7f05\u56e0\u732b\u3002": ["Responsible breeding of premium Maine Coons \u2014 health, type and gentle temperament first.", "\uac74\uac15, \uccb4\ud615, \uc628\ud654\ud55c \uc131\uaca9\uc744 \ucd5c\uc6b0\uc120\uc73c\ub85c \ud504\ub9ac\ubbf8\uc5c4 \uba54\uc778\ucfe4\uc744 \ucc45\uc784 \uc788\uac8c \ubc88\uc2dd\ud569\ub2c8\ub2e4."], "\u67e5\u770b\u732b\u54aa": ["View Our Cats", "\uace0\uc591\uc774 \ubcf4\uae30"], "WeChat \u00b7 \u8054\u7cfb\u6211\u4eec": ["WeChat \u00b7 Contact Us", "WeChat \u00b7 \ubb38\uc758\ud558\uae30"], "\u5411\u4e0b\u63a2\u7d22": ["Scroll Down", "\uc544\ub798\ub85c \ud0d0\uc0c9"], "\u5065\u5eb7\u8840\u7edf": ["Healthy Bloodlines", "\uac74\uac15\ud55c \ud608\ud1b5"], "\u4f18\u79c0\u4f53\u578b": ["Excellent Type", "\uc6b0\uc218\ud55c \uccb4\ud615"], "\u57fa\u56e0\u68c0\u6d4b": ["Genetic Testing", "\uc720\uc804\uc790 \uac80\uc0ac"], "\u72ec\u7acb\u732b\u820d": ["Private Cattery", "\ub3c5\ub9bd \uce90\ud130\ub9ac"], "\u6210\u957f\u8bb0\u5f55": ["Growth Records", "\uc131\uc7a5 \uae30\ub85d"], "\u552e\u540e\u4fdd\u969c": ["Lifetime Support", "\uc0ac\ud6c4 \ubcf4\uc7a5"], "\u5728\u82b1\u56ed\u91cc\u81ea\u5728\u6210\u957f": ["Growing up freely in the garden", "\uc815\uc6d0\uc5d0\uc11c \uc790\uc720\ub86d\uac8c \uc790\ub78d\ub2c8\ub2e4"], "\u9633\u5149\u3001\u81ea\u7136\u4e0e\u8010\u5fc3\u966a\u4f34\u7740\u6bcf\u4e00\u53ea\u5e7c\u732b\u6210\u957f\u3002\u59d3\u540d\u3001\u751f\u65e5\u3001\u6027\u522b\u4e0e\u72b6\u6001\u5c06\u5728\u786e\u8ba4\u540e\u6301\u7eed\u66f4\u65b0\u3002": ["Sunshine, nature and patient care accompany every kitten. Names, birthdays, sex and status are updated as confirmed.", "\ud587\uc0b4\uacfc \uc790\uc5f0, \uc815\uc131 \uc5b4\ub9b0 \ubcf4\uc0b4\ud54c \uc18d\uc5d0\uc11c \uc544\uae30 \uace0\uc591\uc774\ub4e4\uc774 \uc790\ub78d\ub2c8\ub2e4. \uc774\ub984\u00b7\uc0dd\uc77c\u00b7\uc131\ubcc4\u00b7\uc0c1\ud0dc\ub294 \ud655\uc778 \ud6c4 \uc9c0\uc18d \uc5c5\ub370\uc774\ud2b8\ub429\ub2c8\ub2e4."], "\u5168\u90e8": ["All", "\uc804\uccb4"], "\u53ef\u9884\u8ba2": ["Available", "\ubd84\uc591 \uac00\ub2a5"], "\u5df2\u9884\u5b9a": ["Reserved", "\uc608\uc57d\ub428"], "\u5e38\u89c1\u95ee\u9898": ["FAQ", "\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38"], "\u5df2\u5230\u65b0\u5bb6": ["In New Homes", "\uc0c8 \uac00\uc871 \ud488\uc73c\ub85c"], "\u72b6\u6001": ["Status", "\uc0c1\ud0dc"], "\u6027\u522b": ["Sex", "\uc131\ubcc4"], "\u6bdb\u8272": ["Color", "\ubaa8\uc0c9"], "\u5e74\u9f84": ["Age", "\ub098\uc774"], "3\u4e2a\u6708\u4ee5\u4e0b": ["Under 3 months", "3\uac1c\uc6d4 \ubbf8\ub9cc"], "3\u20136\u4e2a\u6708": ["3\u20136 months", "3\u20136\uac1c\uc6d4"], "6\u4e2a\u6708\u4ee5\u4e0a": ["Over 6 months", "6\uac1c\uc6d4 \uc774\uc0c1"], "\u5f1f\u5f1f": ["Boy", "\ub0a8\uc544"], "\u59b9\u59b9": ["Girl", "\uc5ec\uc544"], "\u94f6\u864e\u6591": ["Silver Tabby", "\uc2e4\ubc84 \ud0dc\ube44"], "\u68d5\u864e\u6591": ["Brown Tabby", "\ube0c\ub77c\uc6b4 \ud0dc\ube44"], "\u84dd\u864e\u6591": ["Blue Tabby", "\ube14\ub8e8 \ud0dc\ube44"], "\u7ea2\u864e\u6591": ["Red Tabby", "\ub808\ub4dc \ud0dc\ube44"], "\u70df\u7070\u8272": ["Smoke", "\uc2a4\ubaa8\ud06c"], "\u7eaf\u9ed1\u8272": ["Solid Black", "\uc194\ub9ac\ub4dc \ube14\ub799"], "\u7eaf\u84dd\u8272": ["Solid Blue", "\uc194\ub9ac\ub4dc \ube14\ub8e8"], "\u51ef\u7c73\u5c14\u8272": ["Cameo", "\uce74\uba54\uc624"], "\u6ca1\u6709\u7b26\u5408\u6761\u4ef6\u7684\u732b\u54aa\uff0c\u8bf7\u8c03\u6574\u7b5b\u9009\u6761\u4ef6": ["No cats match the filters \u2014 try adjusting them.", "\uc870\uac74\uc5d0 \ub9de\ub294 \uace0\uc591\uc774\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \ud544\ud130\ub97c \uc870\uc815\ud574 \uc8fc\uc138\uc694."], "\u4f18\u79c0\u8840\u7edf\u4e0e\u5065\u5eb7\u7684\u57fa\u77f3\uff0c\u627f\u8f7d\u7740 Shakoshako \u7684\u672a\u6765\u3002": ["The bedrock of fine bloodlines and good health \u2014 carrying Shakoshako's future.", "\uc6b0\uc218\ud55c \ud608\ud1b5\uacfc \uac74\uac15\uc774\ub77c\ub294 \ucd08\uc11d\uc774 Shakoshako\uc758 \ubbf8\ub798\ub97c \uc774\uc5b4\uac11\ub2c8\ub2e4."], "\u4e3a\u5353\u8d8a\u800c\u7e41\u80b2": ["Bred for Excellence", "\ud0c1\uc6d4\ud568\uc744 \uc704\ud55c \ube0c\ub9ac\ub529"], "\u4f5c\u4e3a WCF \u4e0e CFA \u53cc\u534f\u4f1a\u8ba4\u8bc1\u732b\u820d\uff0c\u6211\u4eec\u76f8\u4fe1\u4f18\u79c0\u7684\u7f05\u56e0\u732b\u4e0d\u4ec5\u62e5\u6709\u4ee4\u4eba\u77a9\u76ee\u7684\u5916\u5f62\uff0c\u66f4\u5e94\u5177\u5907\u5065\u5eb7\u7684\u4f53\u9b44\u4e0e\u6e29\u67d4\u7684\u6027\u683c\u3002": ["As a WCF & CFA dual-certified cattery, we believe an outstanding Maine Coon is not only striking in looks, but healthy in body and gentle in temperament.", "WCF\u00b7CFA \uc774\uc911 \uc778\uc99d \uce90\ud130\ub9ac\ub85c\uc11c, \ud6cc\ub96d\ud55c \uba54\uc778\ucfe4\uc740 \ub6f0\uc5b4\ub09c \uc678\ubaa8\ubfd0 \uc544\ub2c8\ub77c \uac74\uac15\ud55c \uc2e0\uccb4\uc640 \uc628\ud654\ud55c \uc131\uaca9\uc744 \uac16\ucd94\uc5b4\uc57c \ud55c\ub2e4\uace0 \ubbff\uc2b5\ub2c8\ub2e4."], "\u5065\u5eb7\u4f18\u5148": ["Health First", "\uac74\uac15 \uc6b0\uc120"], "HCM \u00b7 PKD \u57fa\u56e0\u68c0\u6d4b\uff0c\u5b9a\u671f\u4f53\u68c0\u4e0e\u9a71\u866b": ["HCM \u00b7 PKD genetic testing, regular check-ups & deworming", "HCM \u00b7 PKD \uc720\uc804\uc790 \uac80\uc0ac, \uc815\uae30 \uac80\uc9c4\u00b7\uad6c\ucda9"], "\u4f18\u79c0\u8840\u7edf": ["Excellent Bloodlines", "\uc6b0\uc218\ud55c \ud608\ud1b5"], "\u79cd\u732b\u6e90\u81ea\u4fc4\u7f57\u65af\u732b\u820d\u7684\u4f18\u8d28\u8840\u7cfb": ["Breeding cats from premium Russian bloodlines", "\ub7ec\uc2dc\uc544 \uce90\ud130\ub9ac \ucd9c\uc2e0\uc758 \uc6b0\uc218 \ud608\ud1b5"], "\u8d23\u4efb\u7e41\u80b2": ["Responsible Breeding", "\ucc45\uc784 \ube0c\ub9ac\ub529"], "\u79d1\u5b66\u7e41\u80b2\u7ba1\u7406\uff0c\u5c0a\u91cd\u751f\u547d\u4e0e\u81ea\u7136\u6210\u957f": ["Scientific breeding management, respect for life and natural growth", "\uacfc\ud559\uc801 \ubc88\uc2dd \uad00\ub9ac\uc640 \uc0dd\uba85 \uc874\uc911"], "\u7ec8\u8eab\u966a\u4f34": ["Lifetime Companionship", "\ud3c9\uc0dd \ud568\uaed8"], "\u5c0f\u732b\u5230\u5bb6\u540e\uff0c\u966a\u4f34\u4e0e\u652f\u6301\u4e00\u76f4\u90fd\u5728": ["Companionship and support long after kittens go home", "\uc544\uae30 \uace0\uc591\uc774\uac00 \uc0c8 \uc9d1\uc5d0 \uac04 \ub4a4\uc5d0\ub3c4 \uacc1\uc5d0\uc11c \ud568\uaed8\ud569\ub2c8\ub2e4"], "\u59cb\u4e8e\u70ed\u7231\uff0c": ["Born of love,", "\uc0ac\ub791\uc5d0\uc11c \uc2dc\uc791\ud574,"], "\u5fe0\u4e8e\u8d23\u4efb\u3002": ["true to responsibility.", "\ucc45\uc784\uc744 \ub2e4\ud569\ub2c8\ub2e4."], "\u6211\u4eec\u4f4d\u4e8e\u4e2d\u56fd\u56db\u5ddd\u6210\u90fd\uff0c\u4e13\u6ce8\u4e8e\u9ad8\u54c1\u8d28\u7f05\u56e0\u732b\u7684\u8d23\u4efb\u7e41\u80b2\u3002": ["Based in Chengdu, Sichuan, China, we focus on responsible breeding of premium Maine Coons.", "\uc911\uad6d \uc4f0\ucd28\uc131 \uccad\ub450\uc5d0 \uc704\uce58\ud558\uba70, \ud504\ub9ac\ubbf8\uc5c4 \uba54\uc778\ucfe4\uc758 \ucc45\uc784 \ubc88\uc2dd\uc5d0 \uc804\ub150\ud569\ub2c8\ub2e4."], "\u4e86\u89e3\u6211\u4eec\u7684\u7e41\u80b2\u7406\u5ff5": ["Our breeding philosophy", "\ube0c\ub9ac\ub529 \ucca0\ud559 \uc54c\uc544\ubcf4\uae30"], "\u6210\u90fd": ["Chengdu", "\uccad\ub450"], "\u732b\u820d\u6240\u5728\u5730": ["Cattery location", "\uce90\ud130\ub9ac \uc704\uce58"], "\u57fa\u56e0\u5065\u5eb7\u68c0\u6d4b": ["Genetic health testing", "\uc720\uc804\uc790 \uac74\uac15 \uac80\uc0ac"], "\u4f18\u8d28\u8840\u7edf": ["Quality bloodlines", "\uc6b0\uc218 \ud608\ud1b5"], "\u7ec6\u81f4\u65e5\u5e38\u7167\u62a4": ["Attentive daily care", "\uc138\uc2ec\ud55c \uc77c\uc0c1 \ucf00\uc5b4"], "\u81ea\u5728\u6210\u957f\u7684\u7a7a\u95f4": ["Space to grow freely", "\uc790\uc720\ub86d\uac8c \uc790\ub77c\ub294 \uacf5\uac04"], "\u72ec\u7acb\u5ead\u9662\u4e0e\u79d1\u5b66\u5206\u533a\uff0c\u4e3a\u6bcf\u4e00\u53ea\u732b\u63d0\u4f9b\u5b89\u9759\u3001\u6d01\u51c0\u4e14\u9633\u5149\u5145\u8db3\u7684\u6210\u957f\u73af\u5883\u3002": ["A private garden and thoughtful zoning give every cat a quiet, clean, sunlit environment.", "\ub3c5\ub9bd \uc815\uc6d0\uacfc \uacfc\ud559\uc801\uc778 \uad6c\uc5ed \ubd84\ub9ac\ub85c \uc870\uc6a9\ud558\uace0 \uccad\uacb0\ud558\uba70 \ud587\uc0b4 \uac00\ub4dd\ud55c \ud658\uacbd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."], "\u72ec\u7acb\u5ead\u9662": ["Private Garden", "\ub3c5\ub9bd \uc815\uc6d0"], "\u9633\u5149\u5145\u8db3\uff0c\u81ea\u7531\u6d3b\u52a8": ["Plenty of sunshine, free to roam", "\ucda9\ubd84\ud55c \ud587\uc0b4, \uc790\uc720\ub85c\uc6b4 \ud65c\ub3d9"], "\u6bcd\u5a74\u7a7a\u95f4": ["Mother & Kitten Space", "\ubaa8\uc790 \uacf5\uac04"], "\u4e3a\u6bcd\u732b\u4e0e\u5e7c\u732b\u51c6\u5907\u7684\u6e29\u6696\u5b89\u9759\u533a\u57df": ["A warm, quiet area for mothers and kittens", "\uc5b4\ubbf8\uc640 \uc544\uae30\ub97c \uc704\ud55c \ub530\ub73b\ud558\uace0 \uc870\uc6a9\ud55c \uacf5\uac04"], "\u751f\u6d3b\u7a7a\u95f4": ["Living Space", "\uc0dd\ud65c \uacf5\uac04"], "\u516c\u732b\u3001\u6bcd\u732b\u4e0e\u6d3b\u52a8\u533a\u57df\u72ec\u7acb\u7ba1\u7406": ["Males, females and play areas managed separately", "\uc218\ucef7\u00b7\uc554\ucef7\u00b7\ub180\uc774 \uad6c\uc5ed \ubd84\ub9ac \uad00\ub9ac"], "\u79d1\u5b66\u4e0e\u7528\u5fc3\u5b88\u62a4\u5065\u5eb7": ["Health, guarded with science and care", "\uacfc\ud559\uacfc \uc815\uc131\uc73c\ub85c \uc9c0\ud0a4\ub294 \uac74\uac15"], "\u4ee5\u751f\u9aa8\u8089\u4e3a\u4e3b\u7684\u996e\u98df\u3001\u5408\u7406\u8425\u517b\u8865\u5145\u4e0e\u4f18\u8d28\u732b\u7802\uff0c\u4e3a\u6bcf\u4e00\u53ea\u732b\u6253\u4e0b\u5065\u5eb7\u57fa\u7840\u3002": ["A raw-based diet, balanced supplements and premium litter lay the foundation of health.", "\uc0dd\uc2dd \uc704\uc8fc\uc758 \uc2dd\ub2e8, \uade0\ud615 \uc7a1\ud78c \uc601\uc591 \ubcf4\ucda9, \ud504\ub9ac\ubbf8\uc5c4 \ubaa8\ub798\ub85c \uac74\uac15\uc758 \uae30\ucd08\ub97c \ub2e4\uc9d1\ub2c8\ub2e4."], "\u4ece\u521d\u6b21\u76f8\u9047\u5230\u6210\u4e3a\u5bb6\u4eba": ["From first meeting to becoming family", "\uccab \ub9cc\ub0a8\uc5d0\uc11c \uac00\uc871\uc774 \ub418\uae30\uae4c\uc9c0"], "\u9009\u732b\u3001\u5b9a\u91d1\u3001\u5408\u540c\u3001\u5c3e\u6b3e\u3001\u63a5\u732b\u4e0e\u552e\u540e\uff0c\u6bcf\u4e00\u6b65\u6e05\u6670\u900f\u660e\uff0c\u5e76\u4e3a\u65b0\u5bb6\u5ead\u63d0\u4f9b\u6301\u7eed\u6307\u5bfc\u3002": ["Choosing, deposit, contract, balance, pickup and aftercare \u2014 every step clear and transparent, with ongoing guidance for new families.", "\uc120\ud0dd\u00b7\uacc4\uc57d\uae08\u00b7\uacc4\uc57d\uc11c\u00b7\uc794\uae08\u00b7\uc778\ub3c4\u00b7\uc0ac\ud6c4\uad00\ub9ac\uae4c\uc9c0 \ubaa8\ub4e0 \ub2e8\uacc4\uac00 \ud22c\uba85\ud558\uba70, \uc0c8 \uac00\uc871\uc5d0\uac8c \uc9c0\uc18d\uc801\uc778 \uc548\ub0b4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."], "\u67e5\u770b\u5e7c\u732b": ["View kittens", "\uc544\uae30 \uace0\uc591\uc774 \ubcf4\uae30"], "\u901a\u8fc7\u771f\u5b9e\u7167\u7247\u548c\u89c6\u9891\u4e86\u89e3\u5e7c\u732b": ["Get to know kittens through real photos and videos", "\uc2e4\uc81c \uc0ac\uc9c4\uacfc \uc601\uc0c1\uc73c\ub85c \uc544\uae30 \uace0\uc591\uc774 \ud655\uc778"], "\u9009\u62e9\u5e7c\u732b": ["Choose your kitten", "\uc544\uae30 \uace0\uc591\uc774 \uc120\ud0dd"], "\u901a\u8fc7\u5fae\u4fe1\u6c9f\u901a\u5e76\u786e\u8ba4\u5fc3\u4eea\u5e7c\u732b": ["Chat on WeChat and confirm your favorite", "\uc704\ucc57\uc73c\ub85c \uc0c1\ub2f4 \ud6c4 \ub9c8\uc74c\uc5d0 \ub4dc\ub294 \uc544\uc774 \ud655\uc815"], "\u652f\u4ed8\u5b9a\u91d1": ["Pay deposit", "\uacc4\uc57d\uae08 \uacb0\uc81c"], "\u652f\u4ed830%\u5b9a\u91d1\u5e76\u7b7e\u8ba2\u7535\u5b50\u5408\u540c": ["Pay a 30% deposit and sign an e-contract", "30% \uacc4\uc57d\uae08 \uacb0\uc81c \ubc0f \uc804\uc790 \uacc4\uc57d \uccb4\uacb0"], "\u652f\u4ed8\u5c3e\u6b3e": ["Pay balance", "\uc794\uae08 \uacb0\uc81c"], "\u63a5\u732b\u524d\u4e00\u5929\u4ed8\u6e05\u5c3e\u6b3e": ["Settle the balance the day before pickup", "\uc778\ub3c4 \uc804\ub0a0 \uc794\uae08 \uacb0\uc81c"], "\u5b89\u5168\u63a5\u732b": ["Safe pickup", "\uc548\uc804\ud55c \uc778\ub3c4"], "\u53ef\u5728\u6210\u90fd\u63a5\u732b\u6216\u5b89\u6392\u822a\u7a7a\u8fd0\u8f93": ["Pickup in Chengdu or air transport arranged", "\uccad\ub450 \ud53d\uc5c5 \ub610\ub294 \ud56d\uacf5 \uc6b4\uc1a1 \uac00\ub2a5"], "\u7ec8\u8eab\u652f\u6301": ["Lifetime support", "\ud3c9\uc0dd \uc9c0\uc6d0"], "\u63d0\u4f9b\u5065\u5eb7\u4fdd\u969c\u4e0e\u7ec8\u8eab\u9972\u517b\u6307\u5bfc": ["Health guarantee and lifetime care guidance", "\uac74\uac15 \ubcf4\uc7a5\uacfc \ud3c9\uc0dd \uc0ac\uc721 \uc548\ub0b4 \uc81c\uacf5"], "\u6bcf\u4e00\u53ea\u7f05\u56e0\u732b\uff0c": ["Every Maine Coon", "\ubaa8\ub4e0 \uba54\uc778\ucfe4\uc740,"], "\u90fd\u662f\u4e00\u6bb5\u4f20\u5947\u7684\u5f00\u59cb\u3002": ["is the beginning of a legend.", "\ud558\ub098\uc758 \uc804\uc124\uc758 \uc2dc\uc791\uc785\ub2c8\ub2e4."], "SHAKOSHAKO CATTERY \u00b7 \u6210\u90fd": ["SHAKOSHAKO CATTERY \u00b7 CHENGDU", "SHAKOSHAKO CATTERY \u00b7 \uccad\ub450"], "\u5173\u6ce8 Shakoshako": ["Follow Shakoshako", "Shakoshako \ud314\ub85c\uc6b0"], "\u901a\u8fc7\u5b98\u65b9\u793e\u4ea4\u5e73\u53f0\u4e86\u89e3\u732b\u820d\u65e5\u5e38\u3001\u5e7c\u732b\u6210\u957f\u8bb0\u5f55\u4e0e\u6700\u65b0\u6d88\u606f\u3002": ["Follow our official channels for daily life, kitten updates and news.", "\uacf5\uc2dd \ucc44\ub110\uc5d0\uc11c \uce90\ud130\ub9ac \uc77c\uc0c1\uacfc \uc544\uae30 \uace0\uc591\uc774 \uc18c\uc2dd\uc744 \ub9cc\ub098\ubcf4\uc138\uc694."], "\u5c0f\u7ea2\u4e66": ["Xiaohongshu", "\uc0e4\uc624\ud64d\uc288"], "\u94fe\u63a5\u5373\u5c06\u5f00\u653e": ["Link coming soon", "\ub9c1\ud06c \uc624\ud508 \uc608\uc815"], "\u8bbf\u95ee\u5b98\u65b9\u4e3b\u9875": ["Visit official page", "\uacf5\uc2dd \ud398\uc774\uc9c0 \ubc29\ubb38"], "\u54a8\u8be2\u5e7c\u732b\u3001\u9884\u8ba2\u6216\u4e86\u89e3\u732b\u820d\u4fe1\u606f\uff0c\u6b22\u8fce\u901a\u8fc7\u4ee5\u4e0b\u5b98\u65b9\u6e20\u9053\u8054\u7cfb\u6211\u4eec\uff1b\u4e5f\u6b22\u8fce\u5173\u6ce8\u6211\u4eec\u7684\u793e\u4ea4\u5e73\u53f0\uff0c\u770b\u770b\u732b\u820d\u65e5\u5e38\u4e0e\u5e7c\u732b\u7684\u6210\u957f\u8bb0\u5f55\u3002": ["For kitten inquiries, reservations or general questions, reach us through the official channels below \u2014 and follow our social accounts for cattery life and kitten updates.", "\uc544\uae30 \uace0\uc591\uc774 \ubb38\uc758\u00b7\uc608\uc57d\uc740 \uc544\ub798 \uacf5\uc2dd \ucc44\ub110\ub85c \uc5f0\ub77d\ud574 \uc8fc\uc138\uc694. \uc18c\uc15c \uacc4\uc815\uc5d0\uc11c \uce90\ud130\ub9ac \uc77c\uc0c1\uacfc \uc544\uae30 \uace0\uc591\uc774\uc758 \uc131\uc7a5 \uae30\ub85d\ub3c4 \ub9cc\ub098\ubcf4\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."], "\u5982\u9700\u54a8\u8be2\u5e7c\u732b\u3001\u9884\u8ba2\u6216\u4e86\u89e3\u732b\u820d\u4fe1\u606f\uff0c\u8bf7\u901a\u8fc7\u5b98\u65b9\u6e20\u9053\u8054\u7cfb\u6211\u4eec\u3002": ["For kitten inquiries, reservations or cattery info, contact us via official channels.", "\uc544\uae30 \uace0\uc591\uc774 \ubb38\uc758\u00b7\uc608\uc57d\u00b7\uce90\ud130\ub9ac \uc815\ubcf4\ub294 \uacf5\uc2dd \ucc44\ub110\ub85c \uc5f0\ub77d\ud574 \uc8fc\uc138\uc694."], "\u5fae\u4fe1": ["WeChat", "\uc704\ucc57"], "\u7535\u8bdd": ["Phone", "\uc804\ud654"], "\u70b9\u51fb\u62e8\u6253\u7535\u8bdd": ["Tap to call", "\uc804\ud654 \uac78\uae30"], "\u5fae\u4fe1\u54a8\u8be2": ["WeChat Inquiry", "\uc704\ucc57 \ubb38\uc758"], "\u7535\u8bdd\u54a8\u8be2": ["Phone Inquiry", "\uc804\ud654 \ubb38\uc758"], "\u6765\u81ea\u4e16\u754c\u5404\u5730\u7684\u670b\u53cb": ["Friends from around the world", "\uc138\uacc4 \uac01\uc9c0\uc5d0\uc11c \uc628 \uce5c\uad6c\ub4e4"], "\u56fd\u5185\u8bbf\u5ba2": ["Visitors in China", "\uc911\uad6d \ubc29\ubb38\uc790"], "\u4e16\u754c\u5730\u56fe": ["World Map", "\uc138\uacc4 \uc9c0\ub3c4"], "\u732b\u820d\u52a8\u6001": ["Cattery News", "\uce90\ud130\ub9ac \uc18c\uc2dd"], "\u5bb6\u957f\u53cd\u9988": ["Family Updates", "\uac00\uc871 \ud6c4\uae30"], "\u5c0f\u732b\u8db3\u8ff9": ["Kitten Footprints", "\uc544\uae30 \uace0\uc591\uc774 \ubc1c\uc790\uad6d"], "\u7238\u7238\u5988\u5988": ["Mom & Dad", "\uc5c4\ub9c8 \uc544\ube60"], "\u65e5\u5e38\u5582\u517b": ["Feeding & Care", "\uc77c\uc0c1 \uae09\uc5ec"], "\u8d2d\u4e70\u6d41\u7a0b": ["Purchase Process", "\uad6c\ub9e4 \uc808\ucc28"], "\u5de6\u53f3\u6ed1\u52a8\u67e5\u770b\u66f4\u591a\u7167\u7247": ["Swipe to see more photos", "\uc88c\uc6b0\ub85c \ubc00\uc5b4 \ub354 \ub9ce\uc740 \uc0ac\uc9c4 \ubcf4\uae30"], "\u00a9 2026 Shakoshako Maine Coon Cattery \u00b7 Chengdu, China \u00b7 \u7248\u6743\u6240\u6709": ["\u00a9 2026 Shakoshako Maine Coon Cattery \u00b7 Chengdu, China \u00b7 All rights reserved", "\u00a9 2026 Shakoshako Maine Coon Cattery \u00b7 Chengdu, China \u00b7 \ud310\uad8c \uc18c\uc720"], "\u7d2f\u8ba1\u8bbf\u95ee": ["Total visits", "\ucd1d \ubc29\ubb38"], "\u6b21": ["", "\ud68c"], "\u65b0\u5bb6\u793c\u5305": ["Go-Home Kit", "\uc0c8 \uac00\uc815 \uc120\ubb3c \ud328\ud0a4\uc9c0"], "\u5168\u7403": ["Global", "\uae00\ub85c\ubc8c"], "\u4e2d\u56fd": ["China", "\uc911\uad6d"], "\u65b0\u5bb6\u793c\u5305\u4f1a\u968f\u5c0f\u732b\u4e00\u540c\u5feb\u9012\u5bc4\u51fa\uff0c\u5185\u542b\uff1a": ["The go-home kit ships with your kitten and includes:", "\uc0c8 \uac00\uc815 \ud328\ud0a4\uc9c0\ub294 \uc544\uae30 \uace0\uc591\uc774\uc640 \ud568\uaed8 \ud0dd\ubc30\ub85c \ubc1c\uc1a1\ub418\uba70, \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4:"], "\u65e5\u5e38\u7528\u54c1": ["Daily supplies", "\uc77c\uc0c1 \uc6a9\ud488"], "\u732b\u7cae": ["Cat food", "\uc0ac\ub8cc"], "\u5e38\u7528\u836f\u54c1": ["Basic medications", "\uc0c1\ube44\uc57d"], "\u5e7c\u732b\u7cae": ["Kitten food", "\uc544\uae30 \uace0\uc591\uc774 \uc0ac\ub8cc"], "\u719f\u6089\u6c14\u5473\u7684\u5c0f\u6bef\u5b50": ["Blanket with familiar scent", "\uc775\uc219\ud55c \ub0c4\uc0c8\uc758 \ub2f4\uc694"], "\u73a9\u5177": ["Toys", "\uc7a5\ub09c\uac10"], "\u75ab\u82d7\u672c\u4e0e\u9a71\u866b\u8bb0\u5f55": ["Vaccination & deworming records", "\uc608\ubc29\uc811\uc885\u00b7\uad6c\ucda9 \uae30\ub85d"], "\u7535\u5b50\u5408\u540c": ["E-contract", "\uc804\uc790 \uacc4\uc57d\uc11c"], "\u7ec8\u8eab\u9972\u517b\u6307\u5bfc": ["Lifetime care guidance", "\ud3c9\uc0dd \uc0ac\uc721 \uc548\ub0b4"], "\u5728\u552e\u732b\u54aa": ["Kittens Available", "\ubd84\uc591 \uac00\ub2a5 \uace0\uc591\uc774"], "\u5df2\u552e\u732b\u54aa": ["Kittens Rehomed", "\ubd84\uc591 \uc644\ub8cc \uace0\uc591\uc774"], "\u6210\u7acb\u65e5\u671f": ["Established", "\uc124\ub9bd\uc77c"], "\u8377\u5170": ["Netherlands", "\ub124\ub35c\ub780\ub4dc"], "\u51fa\u751f": ["Born", "\ucd9c\uc0dd"], "\u51fa\u552e": ["Sold", "\ubd84\uc591"], "\u516c\u544a": ["Notice", "\uacf5\uc9c0"], "\u552e\u5f80\u5730\u533a": ["Kittens Rehomed To", "\ubd84\uc591 \uc9c0\uc5ed"], "\u56fd\u5185\u5730\u56fe": ["China Map", "\uc911\uad6d \uc9c0\ub3c4"], "\u6d77\u5916\u8bbf\u5ba2": ["International Visitors", "\ud574\uc678 \ubc29\ubb38\uc790"], "\u6e38\u4e50\u533a": ["Play Area", "\ub180\uc774 \uacf5\uac04"], "\u82b1\u56ed\u5c0f\u5f84": ["Garden Path", "\uc815\uc6d0 \uc0b0\ucc45\ub85c"], "\u79cd\u516c": ["Sire", "\uc544\ube60 \uace0\uc591\uc774"], "\u79cd\u6bcd": ["Dam", "\uc5c4\ub9c8 \uace0\uc591\uc774"], "\u603b\u8bbf\u95ee\u91cf": ["Page Views", "\ucd1d \uc870\ud68c\uc218"], "\u72ec\u7acb\u8bbf\u5ba2": ["Unique Visitors", "\uc21c \ubc29\ubb38\uc790"], "\u70b9\u51fb\u67e5\u770b\u5404\u56fd\u5bb6\u4e0e\u5730\u533a\u7684\u8bbf\u95ee\u660e\u7ec6 \u2197\ufe0e": ["View visit details by country & region \u2197\ufe0e", "\uad6d\uac00\u00b7\uc9c0\uc5ed\ubcc4 \ubc29\ubb38 \uae30\ub85d \ubcf4\uae30 \u2197\ufe0e"]};
module.exports = {
  t: function (s, lang) {
    if (!lang) return s;
    var e = D[s];
    return (e && e[lang - 1]) || s;
  }
